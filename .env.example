# Copy to .env and fill in. Never commit .env.

# Which business folder to serve (business.json + knowledge/)
BUSINESS_FOLDER=demo/clinic
# mock = offline, free, for demos and tests. claude = coming with the Claude adapter.
MODEL=mock
# Websites allowed to embed the chat window, comma-separated
ALLOWED_ORIGINS=
# Messages per day for the whole business (protects the AI bill)
DAILY_MESSAGE_CAP=500

# --- Google Sheets conversation log (optional) ---
SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# --- "Talk to a person": Telegram and/or email (at least one in production) ---
# A separate bot from @BotFather; chat id of the staff chat or group
HANDOFF_TELEGRAM_BOT_TOKEN=
HANDOFF_TELEGRAM_CHAT_ID=
# SMTP: port 465 = SSL, 587 = STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
HANDOFF_EMAIL_FROM=
# comma-separated
HANDOFF_EMAIL_TO=
